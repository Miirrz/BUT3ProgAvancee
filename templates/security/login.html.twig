{% extends 'base.html.twig' %}
{% trans_default_domain 'login' %}

{% block title %} {{"page" | trans}} {% endblock %}

{% block stylesheets %}
    <link href="{{ asset('../css/login.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}

<h1 class="h3 mb-3 font-weight-normal"> {{"titre" | trans}} </h1>

<form method="post">

    {% if app.user %}
        <div class="mb-3">
            You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
        </div>
    {% endif %}
    
    <div class="champs">
        <div class="email">
            <label for="inputEmail">Email</label>
            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>
        </div>
        <div class="password">    
            <label for="inputPassword">{{ "mdp" | trans }}</label>
            <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        </div>
    </div>
    <div class="rememberMe">
        <label>
            <input type="checkbox" name="_remember_me"> {{ "souvenir" | trans }}
        </label>
    </div>

    {% if error %}
    <div class="alert alert-danger">
        <span class="loginErreurIcone">⚠️</span>
        <span class="loginErreurText"> {{ error.messageKey|trans(error.messageData, 'security') }}</span>
    </div>

    {% endif %}

    <button class="validerForm" type="submit">
        {{ "bouton" | trans }}
    </button>
</form>
{% endblock %}
