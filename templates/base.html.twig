<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="icon" type="image/png" href="{{ asset('assets/bonfire.png') }}" >

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>
        <header class="banniere">
            <div class="banniereContenu">
                <a href="{{ path('accueil') }}" class="banniereGauche">
                    <img src="https://img1.picmix.com/output/stamp/normal/4/1/4/2/2292414_166dc.png" class="banniereLogo">
                    <span class="banniereTitre">L'Entre-Braise</span>
                </a>

                <div class="banniereDroite">
                    <a href="{{ path('app_login') }}" class="banniereLogin">
                        Connexion
                    </a>
                </div>
            </div>
        </header>

        <main class="contenuPage">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
