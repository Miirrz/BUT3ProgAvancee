<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>

        <link rel="icon" type="image/png" href="{{ asset('assets/bonfire.png') }}" >

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>

    <body>
        <header class="banniere">
            <div class="banniereContenu">
                <a href="{{ path('accueil') }}" class="banniereGauche">
                    <img src="https://img1.picmix.com/output/stamp/normal/4/1/4/2/2292414_166dc.png" class="banniereLogo">
                    <span class="banniereTitre">L'Entre-Braise</span>
                    {% if is_granted('ROLE_ADMIN') %} 
                        <a href="{{ path('admin')}}">Tableau de bord</a>
                    {% endif %}
                </a>
                
                <div class="banniereDroite">
                    <div class="choixLangage">
                        <div class="langageChoisi">
                            <img src="{{ asset('styles/images/' ~ app.request.locale  ~ '.png') }}">
                        </div>
                        <ul class="selectionLangage">
                            <li><a href="{{ path('change_locale', {'locale': 'fr'}) }}">
                                <img src="{{ asset('styles/images/fr.png') }}"></a>
                            </li>
                            <li><a href="{{ path('change_locale', {'locale': 'en'}) }}">
                                <img src="{{ asset('styles/images/en.png') }}" ></a>
                            </li>
                        </ul>
                    </div>
                    {% if app.user %} 
                        <a href="{{ path('app_logout') }}" class="banniereLogout">
                            Déconnexion
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="banniereLogin">
                            Connexion
                        </a>
                        <a href="{{ path('app_register') }}" class="banniereInscription">
                            Inscription
                        </a>
                    {% endif %}
                </div>
            </div>
        </header>

        <main class="contenuPage">
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
